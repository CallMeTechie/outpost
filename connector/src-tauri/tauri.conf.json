{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Outpost Connector",
  "version": "0.0.2",
  "identifier": "de.callmetechie.outpost",
  "build": {
    "frontendDist": "../../client/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "yarn client:dev",
    "beforeBuildCommand": "yarn client:build"
  },
  "app": {
    "windows": [
      {
        "title": "Outpost Connector",
        "width": 1450,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' https: http: ws: wss: data: blob:; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self' https: http: ws: wss:; img-src 'self' https: http: data: blob:; font-src 'self' https: http: data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcyNjUxRUE2MjcxRUM3QjcKUldTM3h4NG5waDVsY28zVFB5WHZ1Yk1GMkhVMmpmNVBkaTJzTytpRDU3ZnFjUEptaHByb0ZkVjkK",
      "endpoints": [
        "https://github.com/CallMeTechie/outpost/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
