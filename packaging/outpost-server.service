[Unit]
Description=Outpost Server
Documentation=https://docs.nexterm.dev/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=outpost
Group=outpost
WorkingDirectory=/var/lib/outpost-server
EnvironmentFile=-/etc/outpost-server/server.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/outpost-server
Restart=on-failure
RestartSec=5

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ReadWritePaths=/var/lib/outpost-server

[Install]
WantedBy=multi-user.target